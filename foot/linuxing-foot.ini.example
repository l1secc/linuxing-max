# ============================================================================
#  Linuxing Max — translucent terminal
#
#  Appended to ~/.config/foot/foot.ini between managed markers by
#  tools/linuxing-bootstrap (and removed again by tools/install.sh --uninstall).
#
#  This is foot's *own* background alpha, not a Hyprland window opacity: the
#  background goes translucent while the text stays fully opaque and crisp.
#  Hyprland's blur (see hypr/looknfeel.lua.example) is what turns that into glass.
#
#  Tune `alpha` between 1.0 (opaque) and 0.0 (fully transparent); 0.78–0.88 is
#  the comfortable range on a photo wallpaper. 0.82 is the "reduced opacity"
#  Linuxing default.
# ============================================================================

# foot's own translucency lives in the [colors-dark] section (there is no
# plain [colors] section). Sections may repeat, so appending this block at the
# end of foot.ini only adds these two keys — the palette included from the
# theme stays in effect.
[colors-dark]
alpha=0.82
alpha-mode=matching
