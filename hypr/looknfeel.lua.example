-- ============================================================================
--  Linuxing Max — look'n'feel
--
--  Omarchy's default look is square and flat: decoration:rounding = 0, no
--  shadows, no blur. This is the soft, glassy Linuxing variant. It lives in
--  the sanctioned user override (~/.config/hypr/looknfeel.lua), loaded after
--  Omarchy's defaults, so package updates keep improving the defaults without
--  touching it.
--
--  Installed by tools/linuxing-bootstrap (from hypr/looknfeel.lua.example).
--
--  Three things worth knowing:
--    * The Omarchy shell mirrors decoration:rounding into its own
--      Style.cornerRadius, so this single value also softens the bar, menus,
--      launcher, notifications and OSD. It reads it on shell start and after a
--      theme is applied.
--    * Blur is what makes the translucent terminal (foot's own `alpha`, see
--      foot/linuxing-foot.ini) read as glass instead of mud.
--    * The window border gradient is generated from colors.toml into the
--      theme's hyprland.lua, so it follows whichever scheme is active — the
--      active/inactive border is deliberately NOT set here.
-- ============================================================================

hl.config({
  decoration = {
    -- Soft, round corners — the "yumuşatılmış" (softened) half.
    -- Tunable: 10 = subtle, 16 = this, 22 = bubbly.
    rounding = 16,
    -- 2 (default) is a plain circle corner; 3 is the softer squircle.
    rounding_power = 3,

    -- Diffused depth so rounded edges read as soft instead of cut out.
    shadow = {
      enabled = true,
      range = 28,
      render_power = 3,
      color = "rgba(000000a6)",
      color_inactive = "rgba(00000073)",
      offset = { 0, 2 },
    },

    -- Glassmorphism: what shows through a translucent surface is blurred.
    blur = {
      enabled = true,
      size = 7,
      -- 2 passes read the same as 3 for this radius and cost less per frame.
      passes = 2,
      noise = 0.0117,
      contrast = 1.0,
      brightness = 1.0,
      new_optimizations = true,
    },
  },
})

-- ============================================================================
--  App translucency — a notch below Omarchy's default ("opaklığı azaltılmış")
--
--  Omarchy tags every window `default-opacity` and applies "0.985 0.96"
--  (active / inactive) in default/hypr/windows.lua. This file loads after
--  those defaults, so this rule wins: apps sit a touch more transparent while
--  their text stays fully crisp, and the blur above turns the see-through
--  background into glass.
--
--  Windows that opted out with `-default-opacity` (video players, PiP, games,
--  screen sharing) are deliberately left alone.
--
--  Tunable: "0.96 0.92" = barely there, "0.92 0.85" = this, "0.88 0.80" = bold.
-- ============================================================================
o.window({ tag = "default-opacity" }, { opacity = "0.92 0.85" })

-- ============================================================================
--  Motion — "Linuxing glides through the terminal"
--
--  Omarchy's default config path is Lua; this theme's bespoke bezier curves
--  and window animations are defined here so the Lua and legacy paths move
--  the same way: calm, expressive, never jarring.
-- ============================================================================

hl.curve("emphasizedDecel", { type = "bezier", points = { { 0.05, 0.7 }, { 0.1, 1 } } })
hl.curve("emphasizedAccel", { type = "bezier", points = { { 0.3, 0 }, { 0.8, 0.15 } } })
hl.curve("menu_decel", { type = "bezier", points = { { 0.1, 1 }, { 0, 1 } } })
hl.curve("menu_accel", { type = "bezier", points = { { 0.3, 0 }, { 0.8, 0.15 } } })
hl.curve("spring", { type = "bezier", points = { { 0.34, 1.56 }, { 0.64, 1 } } })
hl.curve("glide", { type = "bezier", points = { { 0.25, 0.46 }, { 0.45, 0.94 } } })
hl.curve("expressiveFastSpatial", { type = "bezier", points = { { 0.42, 1.67 }, { 0.21, 0.90 } } })

hl.animation({ leaf = "windowsIn", enabled = true, speed = 3.2, bezier = "spring", style = "popin 80%" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 2, bezier = "emphasizedDecel", style = "popin 90%" })
hl.animation({ leaf = "windowsMove", enabled = true, speed = 3, bezier = "glide", style = "slide" })
hl.animation({ leaf = "border", enabled = true, speed = 10, bezier = "emphasizedDecel" })
hl.animation({ leaf = "fade", enabled = true, speed = 4, bezier = "menu_decel" })
hl.animation({ leaf = "fadeIn", enabled = true, speed = 3, bezier = "menu_decel" })
hl.animation({ leaf = "fadeOut", enabled = true, speed = 2.7, bezier = "menu_accel" })
hl.animation({ leaf = "fadeLayersIn", enabled = true, speed = 3, bezier = "menu_decel" })
hl.animation({ leaf = "fadeLayersOut", enabled = true, speed = 2.7, bezier = "menu_accel" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 7, bezier = "menu_decel", style = "slide" })
hl.animation({ leaf = "layersIn", enabled = true, speed = 2.7, bezier = "emphasizedDecel", style = "popin 93%" })
hl.animation({ leaf = "layersOut", enabled = true, speed = 2.4, bezier = "menu_accel", style = "popin 94%" })
