#!/usr/bin/env bash
# ============================================================================
#  Linuxing Max — wallpaper switcher
#
#  The Linuxing Max palette is one coherent green; the bundled wallpapers are
#  all green terminal scenes, so switching only swaps the wallpaper and keeps
#  the whole system on the same palette.
#
#  Usage:
#    linuxing-scheme               # next wallpaper
#    linuxing-scheme prev          # previous wallpaper
#    linuxing-scheme recon         # jump to a wallpaper by name
#    linuxing-scheme list          # list the wallpapers
# ============================================================================
set -euo pipefail

THEME="linuxing-max"
THEME_DIR="$HOME/.config/omarchy/themes/$THEME"
BG_DIR="$THEME_DIR/backgrounds"
CURRENT_BG="$HOME/.local/state/omarchy/current/background"

QUIET=0
ARG=""
for arg in "$@"; do
  case "$arg" in
    --quiet | -q) QUIET=1 ;;
    -h | --help)
      sed -n '3,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      ARG="$arg"
      ;;
  esac
done

say() { (( QUIET )) || printf '%s\n' "$*"; }
warn() { printf '%s\n' "$*" >&2; }

mapfile -t WALLS < <(find "$BG_DIR" -maxdepth 1 -type f \
  \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | sort)
COUNT=${#WALLS[@]}
if (( COUNT == 0 )); then
  warn "No wallpapers found in $BG_DIR"
  exit 1
fi

title_of() { local b=${1##*/}; b=${b%.*}; b=${b#Linuxing-}; b=${b#[0-9][0-9]-}; printf '%s' "$b"; }

current_index() {
  local bg base i
  bg=$(readlink -f "$CURRENT_BG" 2>/dev/null || true)
  [[ -n $bg ]] || { printf '%s' -1; return; }
  base=${bg##*/}
  for i in "${!WALLS[@]}"; do
    [[ "${WALLS[$i]##*/}" == "$base" ]] && { printf '%s' "$i"; return; }
  done
  printf '%s' -1
}

if [[ $ARG == list ]]; then
  idx=$(current_index)
  for i in "${!WALLS[@]}"; do
    marker=" "
    (( i == idx )) && marker="*"
    printf '%s %s\n' "$marker" "$(title_of "${WALLS[$i]}")"
  done
  exit 0
fi

INDEX=$(current_index)
TARGET=-1

case "$ARG" in
  "" | next) TARGET=$(( (INDEX + 1 + COUNT) % COUNT )) ;;
  prev | previous) TARGET=$(( (INDEX - 1 + 2 * COUNT) % COUNT )) ;;
  *)
    for i in "${!WALLS[@]}"; do
      [[ "$(title_of "${WALLS[$i]}")" == "$ARG" ]] && { TARGET=$i; break; }
    done
    if (( TARGET < 0 )); then
      for i in "${!WALLS[@]}"; do
        [[ "$(title_of "${WALLS[$i]}")" == *"$ARG"* ]] && { TARGET=$i; break; }
      done
    fi
    ;;
esac

if (( TARGET < 0 || TARGET >= COUNT )); then
  warn "No wallpaper matches: $ARG"
  warn "have: $(for w in "${WALLS[@]}"; do printf '%s ' "$(title_of "$w")"; done)"
  exit 1
fi

WALL="${WALLS[$TARGET]}"
TITLE="$(title_of "$WALL")"

if [[ "$(readlink -f "$CURRENT_BG" 2>/dev/null || true)" == "$(readlink -f "$WALL")" ]]; then
  say "Linuxing Max: $TITLE already set"
else
  omarchy-theme-bg-set "$WALL" >/dev/null 2>&1 || true
  say "Linuxing Max → $TITLE ($((TARGET + 1))/$COUNT)"
fi

if (( ! QUIET )) && command -v omarchy-notification-send >/dev/null 2>&1; then
  omarchy-notification-send "Linuxing Max · $TITLE" \
    "Duvar kağıdı değişti · $((TARGET + 1))/$COUNT" \
    --image "$WALL" -t 2500 >/dev/null 2>&1 || true
fi
